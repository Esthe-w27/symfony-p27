{% extends 'base.html.twig' %}

{% block title %}Hello CategorieController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Les catégories</h1>

    {% for categorie in categories %}
        {{ categorie.nom  }} - <a href="{{ path('app_categorie_edit', {'id' : categorie.id}) }}">Modifier</a>
        - <a onclick="return confirm('Voulez vous supprimer cette catégorie');" href="{{ path('app_categorie_delete', {'id' : categorie.id}) }}">Supprimer</a>
        <br>
    {% endfor %}

    <a href="{{ path('app_categorie_add') }}">Ajouter une catégorie</a>
</div>
{% endblock %}
